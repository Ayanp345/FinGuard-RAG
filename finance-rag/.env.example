# Copy this file to .env and fill in the values you need.
# Every field also has a sane default in src/config.py, so you only need to
# set what you're overriding.

# --- Generation backend ----------------------------------------------------
# One of: hf_local | anthropic | openai
LLM_BACKEND=hf_local

# Used when LLM_BACKEND=hf_local. Llama-3.1-8B-Instruct is gated on
# HuggingFace — request access at https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
# and create a token at https://huggingface.co/settings/tokens
HF_GENERATION_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_TOKEN=

# Used when LLM_BACKEND=anthropic. Verify the current model id at
# https://docs.claude.com/en/docs/about-claude/models before deploying.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Used when LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Hardware ----------------------------------------------------------------
# "cpu" or "cuda" (only matters for hf_local and the local embedding/
# reranker/NLI models, which always run locally regardless of LLM_BACKEND)
DEVICE=cpu

# --- API security & ops -------------------------------------------------------
# Leave blank to disable auth (fine for local dev; set this before deploying).
API_KEY=
RATE_LIMIT=30/minute
CORS_ALLOW_ORIGINS=["*"]

# Optional: enables response caching. Leave blank to disable.
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO
